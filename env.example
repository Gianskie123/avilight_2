# ============================================================
# AviLight Environment Variables
# Copy this to .env for local dev. Never commit the real .env.
# On Railway: set these in the Variables tab of your service.
# ============================================================

# ── Database (MySQL) ─────────────────────────────────────────
# Railway auto-provides MYSQL_URL. You can also set individually:
DB_HOST=your-railway-mysql-host
DB_PORT=3306
DB_NAME=avilight_db
DB_USER=root
DB_PASS=your-mysql-password

# ── Mail (SMTP via Gmail) ────────────────────────────────────
MAIL_DRIVER=phpmailer
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USER=your@gmail.com
MAIL_PASS=your-gmail-app-password
AVILIGHT_OTP_FROM=your@gmail.com

# ── Google Earth Engine ──────────────────────────────────────
# Paste the ENTIRE contents of your GEE service account JSON here.
# On Railway, set this as a single-line env var (Railway handles multiline).
# Example: {"type":"service_account","project_id":"...","private_key":"..."}
GEE_SA_KEY_JSON={"type":"service_account","project_id":"YOUR_PROJECT","private_key_id":"...","private_key":"-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n","client_email":"avilight@YOUR_PROJECT.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}
GEE_PROJECT_ID=your-gcp-project-id

# ── Model Storage ────────────────────────────────────────────
# Path where uploaded model zip files are stored.
# On Railway: mount a persistent volume at this path.
MODEL_STORAGE_PATH=/var/www/html/api_models

# ── App Settings ─────────────────────────────────────────────
APP_ENV=production
APP_DEBUG=false
APP_URL=https://your-app.up.railway.app

# ── Python API (internal) ────────────────────────────────────
# PHP calls the Python FastAPI backend via this URL (internal only)
PYTHON_API_URL=http://localhost:8000
